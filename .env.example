# Копирай този файл на .env и попълни истинските стойности.
# НИКОГА не commit-вай реалния .env файл в git (виж .gitignore).

# --- Alpaca (вече имаш акаунт) ---
# Взимат се от https://app.alpaca.markets/paper/dashboard/overview -> "View API Keys"
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Finnhub (безплатен таир) ---
# 1. Регистрация: https://finnhub.io/register
# 2. След вход -> Dashboard -> копираш "API key"
FINNHUB_API_KEY=

# --- Financial Modeling Prep (безплатен таир) ---
# ВАЖНО: без този ключ, скенерът пада на статичен fallback списък, който НЕ
# гарантира истински "penny stocks" по пазарна капитализация - силно
# препоръчително е да го сложиш, за да работи реалният market cap филтър.
# 1. Регистрация: https://site.financialmodelingprep.com/register
# 2. Dashboard -> "API Key"
FMP_API_KEY=

# --- Watchlist параметри ---
MAX_UNIVERSE_PRICE=10
# Горен праг на пазарна капитализация - проверява се best-effort през Finnhub
# (изисква FINNHUB_API_KEY, за да важи реално - виж universe.py).
MAX_MARKET_CAP_USD=300000000
# Колко кандидата максимум да проверяваме през Finnhub на едно сканиране.
MAX_MOVERS_CANDIDATES=60
WATCHLIST_SIZE=20
SCAN_INTERVAL_MINUTES=10
FAST_INTERVAL_MINUTES=2

# --- Email алърти през Resend (https://resend.com), НЕ Gmail SMTP ---
# Регистрирай се безплатно с yani.kolev2011@gmail.com -> Dashboard -> "API Keys" -> Create.
# Ако оставиш празно, алъртите отиват само в конзолния лог (виждаш ги в Render logs).
ALERT_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
ALERT_EMAIL_TO=yani.kolev2011@gmail.com

# --- Anti-spam темпо за Resend (безплатен tier = 100 имейла/ден за целия акаунт,
# споделен между двата бота, разпределен 70/30 - виж по-долу) - по
# подразбиране 1 имейл на 7 мин (по избор на потребителя от 17.09: "по 1
# койн на всеки 7-8 минути"), плюс дневен таван 30 (memecoin ботът държи 70;
# по избор на потребителя от 18.09: "70 memecoins 30 pennystocks").
# ВНИМАНИЕ: с 30/ден таван, ако кандидати има постоянно на всеки 7 мин, дневният
# лимит ще се изчерпи след ~3.5ч пазарно време - вдигни MAX_EMAILS_PER_DAY,
# ако искаш алъртите да продължат по-дълго през деня (но внимавай с общата
# 100/ден Resend квота, споделена с memecoin бота). ---
MIN_EMAIL_INTERVAL_SECONDS=420
MAX_EMAILS_PER_DAY=30

# --- "Тихи часове" за имейл алъртите - само между тези часове местно време
# (по подразбиране 07:30-23:00 Europe/Sofia). Алъртите пак се логват в
# Render Logs денонощно - само самото изпращане на email се пропуска. ---
ALERT_QUIET_HOURS_TZ=Europe/Sofia
ALERT_ACTIVE_START_HOUR=7
ALERT_ACTIVE_START_MINUTE=30
ALERT_ACTIVE_END_HOUR=23
ALERT_ACTIVE_END_MINUTE=0

# --- Защита срещу "купуване на върха" (добавено 17.09, същия принцип
# като при memecoin бота) - виж коментара в config.py. ---
MIN_HIGH_POTENTIAL_CONFIRMATIONS=2
PEAK_DRAWDOWN_STOP_PCT=5
